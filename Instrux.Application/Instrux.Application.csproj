<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
      <ProjectReference Include="..\Instrux.Domain\Instrux.Domain.csproj" />
      <ProjectReference Include="..\Instrux.Infrastructure\Instrux.Infrastructure.csproj" />
      <ProjectReference Include="..\Instrux.Services\Instrux.Services.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Resource Include="Resources\**\*" />
    </ItemGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
      <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
      <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
      <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    </ItemGroup>

</Project>
