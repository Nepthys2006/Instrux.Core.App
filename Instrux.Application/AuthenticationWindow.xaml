<Window x:Class="Instrux.Application.AuthenticationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Instrux.Application.Views"
        Title="Instrux Sign In"
        Width="980"
        Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#005461">
    <Border Background="#99005461" CornerRadius="0" MouseLeftButtonDown="OnDragMove">
        <Grid Margin="22">
            <views:AuthenticationView />
        </Grid>
    </Border>
</Window>
